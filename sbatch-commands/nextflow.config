manifest {
  name = 'slurm-psi-sigma-salmon'
  author = 'pipeline team'
  description = 'Nextflow orchestration for STAR + featureCounts + PSI-Sigma + Salmon filtering'
  version = '1.0.0'
  mainScript = 'main.nf'
}

params {
  python = 'python3'
  featurecounts_paired_end = true
}

process {
  executor = 'slurm'
  shell = ['/bin/bash', '-euo', 'pipefail']

  withName: PREP {
    cpus = 12
    memory = '60 GB'
    time = '24h'
    queue = 'glacier'
  }

  withName: STAR_ALIGN {
    cpus = 12
    memory = '60 GB'
    time = '24h'
    queue = 'glacier'
    maxForks = 8
  }

  withName: MAKE_GROUPS {
    cpus = 1
    memory = '2 GB'
    time = '10m'
    queue = 'glacier'
  }

  withName: FEATURE_COUNTS {
    cpus = 12
    memory = '60 GB'
    time = '24h'
    queue = 'glacier'
  }

  withName: PSI_SIGMA {
    cpus = 16
    memory = '60 GB'
    time = '24h'
    queue = 'glacier'
  }

  withName: SALMON_QUANT {
    cpus = 16
    memory = '32 GB'
    time = '24h'
    queue = 'glacier'
    maxForks = 8
  }

  withName: SALMON_FILTER {
    cpus = 4
    memory = '16 GB'
    time = '24h'
    queue = 'glacier'
  }
}

profiles {
  standard {
    process.executor = 'local'
  }

  slurm {
    process.executor = 'slurm'
  }
}
