manifest {
    name = 'slurm-psi-sigma-salmon'
    author = 'pipeline team'
    description = 'Nextflow orchestration for STAR + featureCounts + PSI-Sigma + Salmon filtering'
    version = '1.0.0'
}

params {
    python = 'python3'
    featurecounts_paired_end = true
    project_dir = projectDir
    code_dir = "${projectDir}/code-files"

    // run-level params (env-driven)
    outdir   = System.getenv('OUTDIR')    ?: "${projectDir}/out"
    fastqdir = System.getenv('FASTQ_DIR') ?: "${params.outdir}/gz_files"

    // tool locations (env-driven, with defaults)
    star_bin    = System.getenv('STAR_BIN')    ?: "/sci/labs/zvika.granot/segev.munitz/softwares/STAR-2.7.11b/bin/Linux_x86_64"
    salmon_bin  = System.getenv('SALMON_BIN')  ?: "/sci/labs/zvika.granot/segev.munitz/softwares/Salmon/salmon-latest_linux_x86_64/bin"
    psisigma_dir= System.getenv('PSISIGMA_DIR')?: "/sci/labs/zvika.granot/segev.munitz/softwares/PSI-Sigma-2.1"
    perl_bin    = System.getenv('PERL_BIN')    ?: "/sci/labs/zvika.granot/segev.munitz/softwares/perl5/bin"
    perl5lib    = System.getenv('PERL5LIB')    ?: "/sci/labs/zvika.granot/segev.munitz/softwares/perl5/lib/perl5"

}


process {
    executor = 'slurm'
    shell = ['/bin/bash', '-euo', 'pipefail']

    env.PATH = [
        params.star_bin,
        params.salmon_bin,
        params.psisigma_dir,
        params.perl_bin,
        '$PATH'
    ].join(':')

    // keep PERL5LIB additive
    env.PERL5LIB = "${params.perl5lib}:\$PERL5LIB"

    // propagate run + experiment vars to every process
    env.OUTDIR = params.outdir
    env.FASTQ_DIR = params.fastqdir
    env.KIND = System.getenv('KIND') ?: 'Mouse'
    env.VERSION = System.getenv('VERSION') ?: 'M38'
    env.READ_LENGTH = System.getenv('READ_LENGTH') ?: '100'
    env.THREADS = System.getenv('THREADS') ?: '16'

    // Resource allocations
    withName: PREP           { cpus = 12; memory = '60 GB'; time = '24h'; queue = 'glacier' }
    withName: STAR_ALIGN     { cpus = 12; memory = '60 GB'; time = '24h'; queue = 'glacier'; maxForks = 8 }
    withName: MAKE_GROUPS    { cpus = 1;  memory = '2 GB';  time = '10m'; queue = 'glacier' }
    withName: FEATURE_COUNTS { cpus = 12; memory = '60 GB'; time = '24h'; queue = 'glacier' }
    withName: PSI_SIGMA      { cpus = 16; memory = '60 GB'; time = '24h'; queue = 'glacier' }
    withName: SALMON_QUANT   { cpus = 16; memory = '32 GB'; time = '24h'; queue = 'glacier'; maxForks = 8 }
    withName: SALMON_FILTER  { cpus = 4;  memory = '16 GB'; time = '24h'; queue = 'glacier' }
}

profiles {
    standard { process.executor = 'local' }
    slurm    { process.executor = 'slurm' }
}
