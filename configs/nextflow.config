manifest {
    name = 'slurm-psi-sigma-salmon'
    author = 'pipeline team'
    description = 'Nextflow orchestration for STAR + featureCounts + PSI-Sigma + Salmon filtering'
    version = '1.0.0'
}

params {
    python = 'python3'
    featurecounts_paired_end = true
    project_dir = projectDir
    code_dir = "${projectDir}/code-files"
}

process {
    executor = 'slurm'
    shell = ['/bin/bash', '-euo', 'pipefail']

    // PATH setup from env (site.env), with safe fallbacks
    env.PATH = [
        System.getenv('STAR_BIN') ?: '',
        System.getenv('SALMON_BIN') ?: '',
        System.getenv('PSISIGMA_DIR') ?: '',
        System.getenv('PERL_BIN') ?: '',
        '$PATH'
    ].findAll{ it }.join(':')

    // keep additive
    env.PERL5LIB = "${System.getenv('PERL5LIB') ?: ''}:\$PERL5LIB"

    // propagate exactly what paths.py expects (site.env is source of truth)
    env.OUTDIR = System.getenv('OUTDIR')
    env.FASTQ_DIR = System.getenv('FASTQ_DIR')
    env.KIND = System.getenv('KIND')
    env.VERSION = System.getenv('VERSION')
    env.READ_LENGTH = System.getenv('READ_LENGTH')
    env.THREADS = System.getenv('THREADS')

    env.PERLBASE = System.getenv('PERLBASE')
    env.PSI_SIGMA = System.getenv('PSI_SIGMA')
    env.SALMON_EXE = System.getenv('SALMON_EXE')

    env.REFERENCES_ROOT = System.getenv('REFERENCES_ROOT')
    env.STAR_INDEX_ROOT = System.getenv('STAR_INDEX_ROOT')
    env.SALMON_INDEX_ROOT = System.getenv('SALMON_INDEX_ROOT')
    
    // Resource allocations
    withName: PREP           { cpus = 12; memory = '60 GB'; time = '24h'; queue = 'glacier' }
    withName: STAR_ALIGN     { cpus = 12; memory = '60 GB'; time = '24h'; queue = 'glacier'; maxForks = 8 }
    withName: MAKE_GROUPS    { cpus = 1;  memory = '2 GB';  time = '10m'; queue = 'glacier' }
    withName: FEATURE_COUNTS { cpus = 12; memory = '60 GB'; time = '24h'; queue = 'glacier' }
    withName: PSI_SIGMA      { cpus = 16; memory = '60 GB'; time = '24h'; queue = 'glacier' }
    withName: SALMON_QUANT   { cpus = 16; memory = '32 GB'; time = '24h'; queue = 'glacier'; maxForks = 8 }
    withName: SALMON_FILTER  { cpus = 4;  memory = '16 GB'; time = '24h'; queue = 'glacier' }
}

profiles {
    standard { process.executor = 'local' }
    slurm    { process.executor = 'slurm' }
}
