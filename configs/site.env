# site.env  (bash)

# -------- tools (needed on PATH or referenced directly) --------
export STAR_BIN=/sci/labs/zvika.granot/segev.munitz/softwares/STAR-2.7.11b/bin/Linux_x86_64
export SALMON_BIN=/sci/labs/zvika.granot/segev.munitz/softwares/Salmon/salmon-latest_linux_x86_64/bin
export SALMON_EXE=/sci/labs/zvika.granot/segev.munitz/softwares/Salmon/salmon-latest_linux_x86_64/bin/salmon

export PSISIGMA_DIR=/sci/labs/zvika.granot/segev.munitz/softwares/PSI-Sigma-2.1
export PSI_SIGMA=/sci/labs/zvika.granot/segev.munitz/softwares/PSI-Sigma-2.1/dummyai.pl

export PERLBASE=/sci/labs/zvika.granot/segev.munitz/softwares/perl5
export PERL_BIN=/sci/labs/zvika.granot/segev.munitz/softwares/perl5/bin
export PERL5LIB=/sci/labs/zvika.granot/segev.munitz/softwares/perl5/lib/perl5

# -------- reference/index roots --------
export REFERENCES_ROOT=/sci/labs/zvika.granot/segev.munitz/references
export STAR_INDEX_ROOT=/sci/labs/zvika.granot/segev.munitz/star_indexes
export SALMON_INDEX_ROOT=/sci/labs/zvika.granot/segev.munitz/salmon_indexes

# -------- run paths --------
export OUTDIR=/sci/labs/zvika.granot/segev.munitz/psi_sigma_outputs/run_1
export FASTQ_DIR=/sci/labs/zvika.granot/segev.munitz/psi_sigma_outputs/run_1/gz_files

# -------- experiment --------
export KIND=Mouse
export VERSION=M38
export READ_LENGTH=100
export THREADS=16

# load the variables using the command:
# source site.env
# nextflow run main.nf -profile slurm

